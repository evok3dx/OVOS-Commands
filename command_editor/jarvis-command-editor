#!/usr/bin/python3
"""Small, safe editor for personal Jarvis command phrases."""

import importlib.util
import json
import subprocess
from pathlib import Path

import gi

gi.require_version("Gtk", "3.0")
from gi.repository import Gtk


HOME = Path.home()
PACKAGE = HOME / ".local/src/ovos-skill-jarvis-dispatcher/ovos_skill_jarvis_dispatcher"
BUILTINS_PATH = HOME / ".config/jarvis/builtin-command-phrases.json"


def load_module(name, path):
    spec = importlib.util.spec_from_file_location(name, path)
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    return module


commands = load_module("jarvis_custom_commands", PACKAGE / "custom_commands.py")
profiles = load_module("jarvis_profile", PACKAGE / "profile.py")


class CommandEditor(Gtk.Window):
    def __init__(self):
        super().__init__(title="Jarvis Commands")
        self.set_default_size(820, 720)
        self.set_border_width(16)
        self.profile = profiles.load_profile()
        self.catalog = commands.action_catalog(self.profile)
        self.builtins, self.builtin_inventory = self._read_builtins()
        self.mapping = commands.read_mapping(
            profile=self.profile,
            builtin_phrases=self.builtins,
        )

        outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        self.add(outer)

        title = Gtk.Label()
        title.set_markup("<big><b>Jarvis Commands</b></big>")
        title.set_xalign(0)
        outer.pack_start(title, False, False, 0)

        description = Gtk.Label(
            label="Add your own words to actions Jarvis already knows."
        )
        description.set_xalign(0)
        outer.pack_start(description, False, False, 0)

        filters = Gtk.Box(spacing=8)
        self.search = Gtk.SearchEntry(placeholder_text="Find an action")
        self.search.connect("search-changed", self._refilter)
        filters.pack_start(self.search, True, True, 0)
        self.category = Gtk.ComboBoxText()
        self.category.append_text("All categories")
        for category in sorted({item["category"] for item in self.catalog.values()}):
            self.category.append_text(category)
        self.category.set_active(0)
        self.category.connect("changed", self._refilter)
        filters.pack_start(self.category, False, False, 0)
        outer.pack_start(filters, False, False, 0)

        self.action_store = Gtk.ListStore(str, str, str)
        for action_id, details in sorted(
            self.catalog.items(), key=lambda item: (item[1]["category"], item[1]["label"])
        ):
            self.action_store.append(
                [action_id, details["label"], details["category"]]
            )
        self.action_filter = self.action_store.filter_new()
        self.action_filter.set_visible_func(self._action_visible)
        self.actions = Gtk.TreeView(model=self.action_filter)
        self.actions.set_headers_visible(True)
        for index, label in ((1, "Action"), (2, "Category")):
            renderer = Gtk.CellRendererText()
            column = Gtk.TreeViewColumn(label, renderer, text=index)
            column.set_resizable(True)
            self.actions.append_column(column)
        self.actions.get_selection().connect("changed", self._action_changed)
        action_scroll = Gtk.ScrolledWindow()
        action_scroll.set_policy(Gtk.PolicyType.AUTOMATIC, Gtk.PolicyType.AUTOMATIC)
        action_scroll.set_min_content_height(260)
        action_scroll.add(self.actions)
        outer.pack_start(action_scroll, True, True, 0)

        self.selected_label = Gtk.Label(label="Select an action")
        self.selected_label.set_xalign(0)
        outer.pack_start(self.selected_label, False, False, 0)

        builtin_label = Gtk.Label(label="Built-in phrases")
        builtin_label.set_xalign(0)
        outer.pack_start(builtin_label, False, False, 0)
        self.builtin_store = Gtk.ListStore(str)
        builtin_view = Gtk.TreeView(model=self.builtin_store)
        builtin_view.set_headers_visible(False)
        builtin_view.append_column(
            Gtk.TreeViewColumn("Built-in phrase", Gtk.CellRendererText(), text=0)
        )
        builtin_scroll = Gtk.ScrolledWindow()
        builtin_scroll.set_min_content_height(96)
        builtin_scroll.add(builtin_view)
        outer.pack_start(builtin_scroll, False, True, 0)

        personal_label = Gtk.Label(label="Your phrases")
        personal_label.set_xalign(0)
        outer.pack_start(personal_label, False, False, 0)

        phrase_row = Gtk.Box(spacing=8)
        self.phrase = Gtk.Entry(placeholder_text="New phrase")
        self.phrase.connect("activate", self._add_phrase)
        phrase_row.pack_start(self.phrase, True, True, 0)
        add_button = Gtk.Button(label="Add")
        add_button.connect("clicked", self._add_phrase)
        phrase_row.pack_start(add_button, False, False, 0)
        outer.pack_start(phrase_row, False, False, 0)

        self.phrase_store = Gtk.ListStore(str)
        self.phrases = Gtk.TreeView(model=self.phrase_store)
        self.phrases.set_headers_visible(False)
        self.phrases.append_column(
            Gtk.TreeViewColumn("Personal phrase", Gtk.CellRendererText(), text=0)
        )
        phrase_scroll = Gtk.ScrolledWindow()
        phrase_scroll.set_min_content_height(96)
        phrase_scroll.add(self.phrases)
        outer.pack_start(phrase_scroll, False, True, 0)

        footer = Gtk.Box(spacing=8)
        remove_button = Gtk.Button(label="Remove selected phrase")
        remove_button.connect("clicked", self._remove_phrase)
        footer.pack_start(remove_button, False, False, 0)
        self.status = Gtk.Label()
        self.status.set_xalign(0)
        footer.pack_start(self.status, True, True, 0)
        close_button = Gtk.Button(label="Close")
        close_button.connect("clicked", lambda _button: self.close())
        footer.pack_start(close_button, False, False, 0)
        save_button = Gtk.Button(label="Save & Reload")
        save_button.get_style_context().add_class("suggested-action")
        save_button.connect("clicked", self._save)
        footer.pack_start(save_button, False, False, 0)
        outer.pack_start(footer, False, False, 0)

        first = self.action_filter.get_iter_first()
        if first:
            self.actions.get_selection().select_iter(first)

    @staticmethod
    def _read_builtins():
        try:
            payload = json.loads(BUILTINS_PATH.read_text(encoding="utf-8"))
            if isinstance(payload, list):
                return set(payload), {}
            return set(payload["phrases"]), payload.get("actions", {})
        except (OSError, ValueError):
            return set(), {}

    def _selected_action(self):
        model, selected = self.actions.get_selection().get_selected()
        return model[selected][0] if selected else None

    def _action_visible(self, model, iterator, _data):
        query = self.search.get_text().strip().lower()
        selected_category = self.category.get_active_text()
        action_id = model[iterator][0]
        label = model[iterator][1]
        category = model[iterator][2]
        known_phrases = " ".join(self.builtin_inventory.get(action_id, ()))
        matches_query = not query or query in (
            f"{label} {category} {action_id} {known_phrases}".lower()
        )
        matches_category = selected_category in (None, "All categories", category)
        return matches_query and matches_category

    def _refilter(self, _widget):
        self.action_filter.refilter()

    def _action_changed(self, _selection):
        action_id = self._selected_action()
        self.phrase_store.clear()
        self.builtin_store.clear()
        if not action_id:
            self.selected_label.set_text("Select an action")
            return
        details = self.catalog[action_id]
        self.selected_label.set_text(details["label"])
        for phrase in self.builtin_inventory.get(action_id, details["examples"]):
            self.builtin_store.append([phrase])
        for phrase, mapped_action in self.mapping.items():
            if mapped_action == action_id:
                self.phrase_store.append([phrase])
        self.status.set_text("")

    def _add_phrase(self, _widget):
        action_id = self._selected_action()
        phrase = self.phrase.get_text()
        if not action_id or not phrase.strip():
            self.status.set_text("Choose an action and enter a phrase.")
            return
        candidate = dict(self.mapping)
        candidate[phrase] = action_id
        try:
            self.mapping = commands.validate_mapping(
                candidate,
                profile=self.profile,
                builtin_phrases=self.builtins,
            )
        except commands.CustomCommandError as error:
            self.status.set_text(str(error))
            return
        self.phrase.set_text("")
        self._action_changed(None)
        self.status.set_text("Added. Save to activate it.")

    def _remove_phrase(self, _button):
        model, selected = self.phrases.get_selection().get_selected()
        if not selected:
            self.status.set_text("Select a personal phrase to remove.")
            return
        phrase = model[selected][0]
        self.mapping.pop(phrase, None)
        self._action_changed(None)
        self.status.set_text("Removed. Save to apply it.")

    def _save(self, _button):
        try:
            self.mapping = commands.write_mapping(
                self.mapping,
                profile=self.profile,
                builtin_phrases=self.builtins,
            )
            subprocess.Popen(
                [str(HOME / ".local/bin/jarvis-restart")],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                start_new_session=True,
            )
        except (commands.CustomCommandError, OSError) as error:
            self.status.set_text(f"Could not save: {error}")
            return
        self.status.set_text("Saved. Jarvis is reloading commands.")


if __name__ == "__main__":
    window = CommandEditor()
    window.connect("destroy", Gtk.main_quit)
    window.show_all()
    Gtk.main()
