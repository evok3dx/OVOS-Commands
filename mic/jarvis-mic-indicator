#!/usr/bin/python3
"""Single-instance Cinnamon indicator for the OVOS listener microphone."""

import fcntl
import subprocess
from pathlib import Path

import gi

gi.require_version("Gtk", "3.0")
from gi.repository import GLib, Gtk


HOME = Path.home()
TOGGLE = HOME / ".local/bin/jarvis-mic-toggle"
ACTIVE_ICON = HOME / ".local/share/jarvis/mic-active.svg"
MUTED_ICON = HOME / ".local/share/jarvis/mic-muted.svg"

lock_path = HOME / ".cache/jarvis-mic-indicator.lock"
lock_path.parent.mkdir(parents=True, exist_ok=True)
lock_file = open(lock_path, "w", encoding="utf-8")
try:
    fcntl.flock(lock_file, fcntl.LOCK_EX | fcntl.LOCK_NB)
except BlockingIOError:
    raise SystemExit(0)

indicator = Gtk.StatusIcon()
indicator.set_visible(True)
last_state = None


def listener_active():
    result = subprocess.run(
        [
            "systemctl",
            "--user",
            "is-active",
            "--quiet",
            "ovos-listener.service",
        ],
        check=False,
        timeout=5,
    )
    return result.returncode == 0


def update_indicator():
    global last_state
    active = listener_active()

    if active != last_state:
        indicator.set_from_file(str(ACTIVE_ICON if active else MUTED_ICON))
        indicator.set_tooltip_text(
            "Jarvis microphone active\nClick to mute"
            if active
            else "Jarvis microphone MUTED\nClick to activate"
        )
        last_state = active

    return GLib.SOURCE_CONTINUE


def toggle_listener(_icon):
    subprocess.Popen(
        [str(TOGGLE)],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        start_new_session=True,
    )
    GLib.timeout_add(500, update_indicator)


indicator.connect("activate", toggle_listener)
update_indicator()
GLib.timeout_add_seconds(1, update_indicator)
Gtk.main()
