#!/usr/bin/env bash
set -u

if [[ -e "$HOME/.local/state/jarvis/isolation/active.json" || -L "$HOME/.local/state/jarvis/isolation/active.json" ]]; then
  /usr/bin/python3 - <<'PY'
from pathlib import Path
import subprocess,sys
sys.path.insert(0,str(Path.home()/'.local/src/ovos-skill-jarvis-dispatcher/scripts'))
from control_runtime import microphone_action
try:
    message=microphone_action()
except (OSError,RuntimeError,ValueError,subprocess.SubprocessError):
    raise SystemExit('Microphone control failed. Check Jarvis Overview.')
subprocess.run(['notify-send','Jarvis',message],check=False)
PY
  exit $?
fi

if systemctl --user is-active --quiet ovos-listener.service; then
    systemctl --user stop ovos-listener.service

    if systemctl --user is-active --quiet ovos-listener.service; then
        notify-send -u critical \
            "Jarvis mute failed" \
            "The microphone may still be active."
        exit 1
    fi

    notify-send -u critical -t 0 \
        -i microphone-sensitivity-muted-symbolic \
        "Jarvis microphone MUTED" \
        "Wake word and push-to-command are disabled."
else
    systemctl --user start ovos-listener.service

    if systemctl --user is-active --quiet ovos-listener.service; then
        notify-send -u normal -t 4000 \
            -i audio-input-microphone-symbolic \
            "Jarvis microphone active" \
            "Wake word and push-to-command are available."
    else
        notify-send -u critical -t 0 \
            "Jarvis remains muted" \
            "The listener could not start."
        exit 1
    fi
fi
