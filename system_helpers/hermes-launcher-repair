#!/usr/bin/env bash
set -euo pipefail

launcher="$HOME/.local/share/applications/hermes.desktop"
secure_exec="$HOME/.local/bin/hermes-secure-launch"

mkdir -p "$(dirname "$launcher")"

if [[ ! -f "$launcher" ]]; then
  cat >"$launcher" <<EOF
[Desktop Entry]
Type=Application
Name=Hermes
Comment=Hermes Desktop with isolated Podman tools
Exec=$secure_exec
Terminal=false
StartupNotify=true
StartupWMClass=Hermes
Categories=Utility;
EOF
elif ! grep -Fqx "Exec=$secure_exec" "$launcher"; then
  temporary="$(mktemp "${launcher}.XXXXXX")"
  awk -v replacement="Exec=$secure_exec" '
    /^Exec=/ && !changed { print replacement; changed=1; next }
    { print }
    END { if (!changed) print replacement }
  ' "$launcher" >"$temporary"
  chmod --reference="$launcher" "$temporary"
  mv -f "$temporary" "$launcher"
fi

command -v update-desktop-database >/dev/null 2>&1 &&
  update-desktop-database "$HOME/.local/share/applications" >/dev/null 2>&1 || true
