#!/usr/bin/python3

import subprocess
import sys
from pathlib import Path


AGENTS = {
    "codex": "Codex agent",
    "claude": "Claude agent"
}

SOUND = (
    Path.home() /
    ".local/share/ovos/sounds/jarvis-ready-original.wav"
)


def main():
    if len(sys.argv) != 2 or sys.argv[1] not in AGENTS:
        raise SystemExit("Allowed agents: codex or claude")

    agent = AGENTS[sys.argv[1]]

    if SOUND.is_file():
        subprocess.run(
            [
                "/usr/bin/play",
                "-q",
                "-v",
                "0.45",
                str(SOUND)
            ],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            timeout=5,
            check=False
        )

    subprocess.run(
        [
            "/usr/bin/notify-send",
            "--app-name=Jar",
            "--urgency=normal",
            "--expire-time=5000",
            agent,
            "Response ready"
        ],
        timeout=5,
        check=False
    )


if __name__ == "__main__":
    main()
