#!/usr/bin/env bash
set -u
shopt -s nullglob

action="${1:-}"
app="${2:-}"

# Profiles select stable integration identifiers. Normalise them to the
# existing allowlisted application cases without accepting arbitrary commands.
case "$app" in
  standard_notes) app="notes" ;;
  onlyoffice) app="office" ;;
  claude_desktop) app="claude" ;;
  chatgpt_desktop) app="chatgpt" ;;
  hermes_desktop) app="hermes" ;;
  default_mail)
    exec "$HOME/.local/bin/jarvis-default-app" "$action" mail
    ;;
  proton_mail) app="mail" ;;
  proton_calendar) app="calendar" ;;
esac

window_wait_attempts=40
systemd_run="${JARVIS_SYSTEMD_RUN:-/usr/bin/systemd-run}"

case "$app" in
  calculator)
    window_match="gnome-calculator.Gnome-calculator|org.gnome.Calculator|galculator.Galculator"
    title="Calculator"
    ;;
  settings)
    window_match="cinnamon-settings"
    title="Settings"
    ;;
  files)
    window_match="nemo.Nemo"
    title="Files"
    ;;
  brave)
    window_match="brave-browser.Brave-browser"
    title="Brave"
    ;;
  firefox)
    window_match="Navigator.firefox"
    title="Firefox"
    ;;
  signal)
    window_match="signal.signal"
    title="Signal"
    ;;
  zoom)
    window_match="zoom.zoom"
    title="Zoom"
    ;;
  terminal)
    window_match="gnome-terminal-server.Gnome-terminal"
    title="Terminal"
    ;;
  notes)
    # Standard Notes has used several X11 class spellings across packaging
    # formats. Alternatives are separated with | and find_window() treats
    # each member as an independent literal substring.
    window_match="standard notes.Standard Notes|standard-notes|standardnotes"
    title="Notes"
    ;;
  office)
    window_match="DesktopEditors.ONLYOFFICE"
    title="Office"
    ;;
  claude)
    window_match="com.anthropic.claude.com.anthropic.Claude"
    title="Claude"
    # Claude can take longer than the general app limit on a cold Electron
    # start, especially while restoring its account session.
    window_wait_attempts=120
    ;;
  chatgpt)
    window_match="chatgpt"
    title="ChatGPT"
    window_wait_attempts=120
    ;;
  hermes)
    window_match="hermes.Hermes"
    title="Hermes"
    # Hermes starts its local backend before presenting the Electron window.
    # A cold start can legitimately take longer than the general app limit.
    window_wait_attempts=120
    ;;
  mail)
    window_match="proton mail.Proton Mail"
    title="Mail"
    ;;
  calendar)
    window_match="calendar.proton.me.Brave-browser"
    title="Calendar"
    ;;
  *)
    echo "Unsupported application" >&2
    exit 2
    ;;
esac

find_window() {
  local candidate
  local window_id
  local -a candidates

  # window_match is an allowlisted | separated list of literal X11 window
  # signatures. Do not pass it to a regex engine and do not treat the full
  # string as one literal. This keeps alternative package/window classes
  # portable while preserving exact reviewed matches.
  IFS='|' read -r -a candidates <<< "$window_match"

  for candidate in "${candidates[@]}"; do
    window_id="$(
      wmctrl -lx |
        awk -v wanted="$candidate" '
          index(tolower($0), tolower(wanted)) {
            print $1
            exit
          }
        '
    )"

    if [[ -n "$window_id" ]]; then
      printf '%s\n' "$window_id"
      return 0
    fi
  done

  return 1
}

wait_for_window() {
  local window_id=""
  local attempt

  for ((attempt = 0; attempt < window_wait_attempts; attempt++)); do
    window_id="$(find_window)"

    if [[ -n "$window_id" ]]; then
      printf '%s\n' "$window_id"
      return 0
    fi

    sleep 0.25
  done

  return 1
}

show_window() {
  local window_id="$1"

  wmctrl -ir "$window_id" -b remove,hidden >/dev/null 2>&1 || true
  wmctrl -ia "$window_id"
  xdotool windowactivate --sync "$window_id"

  # Confirm that Cinnamon completed the focus hand-off before returning to a
  # caller that may immediately send a keyboard shortcut.
  for _ in {1..30}; do
    if [[ "$(xdotool getactivewindow 2>/dev/null)" == "$((window_id))" ]]; then
      return 0
    fi
    sleep 0.05
  done

  echo "Could not focus the $title window" >&2
  return 1
}

detached_launch() {
  local unit="jarvis-launch-${app}-$(date +%s%N)"

  "$systemd_run" \
    --user \
    --quiet \
    --collect \
    --property=Type=exec \
    --unit="$unit" \
    -- "$@"
}

launch_window() {
  # Existing applications retain the launch paths used before this update.
  # Only the three newly added basic integrations use desktop discovery here.
  case "$app" in
    calculator|settings|files)
      if [[ -x "$HOME/.local/bin/jarvis-desktop-launch" ]]; then
        if "$HOME/.local/bin/jarvis-desktop-launch" "$app"; then
          return 0
        else
          local launcher_status=$?
          # Only 'no compatible entry' permits the old fixed launch path.
          # Disabled apps and launch errors must not bypass this decision.
          [[ "$launcher_status" == 3 ]] || return 1
        fi
      fi
      ;;
  esac
  case "$app" in
    calculator|settings|files) return 1 ;;
    brave)
      if /usr/bin/flatpak info com.brave.Browser >/dev/null 2>&1; then
        detached_launch /usr/bin/flatpak run com.brave.Browser
      else
        detached_launch /usr/bin/brave-browser-stable
      fi
      ;;
    firefox)
      detached_launch /usr/bin/firefox
      ;;
    signal)
      detached_launch /opt/Signal/signal-desktop
      ;;
    zoom)
      detached_launch /usr/bin/zoom
      ;;
    terminal)
      detached_launch /usr/bin/gnome-terminal
      ;;
    notes)
      if [[ -n "${JARVIS_STANDARD_NOTES:-}" && -x "$JARVIS_STANDARD_NOTES" ]]; then
        detached_launch "$JARVIS_STANDARD_NOTES"
      elif standard_notes="$(command -v standard-notes 2>/dev/null)" && \
           [[ -x "$standard_notes" ]]; then
        detached_launch "$standard_notes"
      elif standard_notes="$(command -v standard-notes-desktop 2>/dev/null)" && \
           [[ -x "$standard_notes" ]]; then
        detached_launch "$standard_notes"
      elif /usr/bin/flatpak info org.standardnotes.standardnotes >/dev/null 2>&1; then
        detached_launch /usr/bin/flatpak run org.standardnotes.standardnotes
      else
        standard_notes_candidates=(
          "$HOME"/Apps/standard-notes*.AppImage
          "$HOME"/Apps/Standard-Notes*.AppImage
          "$HOME"/Apps/standardnotes*.AppImage
          "$HOME"/Apps/StandardNotes*.AppImage
          "$HOME"/Applications/standard-notes*.AppImage
          "$HOME"/Applications/Standard-Notes*.AppImage
          "$HOME"/Applications/standardnotes*.AppImage
          "$HOME"/Applications/StandardNotes*.AppImage
        )
        ((${#standard_notes_candidates[@]})) || return 1
        standard_notes="${standard_notes_candidates[${#standard_notes_candidates[@]}-1]}"
        [[ -x "$standard_notes" ]] || return 1
        detached_launch "$standard_notes"
      fi
      ;;
    claude)
      if [[ -x /usr/bin/claude-desktop ]]; then
        detached_launch \
          /usr/bin/claude-desktop \
          --force-renderer-accessibility
      else
        detached_launch /usr/bin/gtk-launch com.anthropic.Claude
      fi
      ;;
    chatgpt)
      if [[ -x /usr/bin/chatgpt ]]; then
        detached_launch /usr/bin/chatgpt
      elif detached_launch /usr/bin/gtk-launch com.openai.ChatGPT; then
        :
      else
        detached_launch /usr/bin/gtk-launch chatgpt
      fi
      ;;
    hermes)
      detached_launch "$HOME/.local/bin/hermes-secure-launch"
      ;;
    mail)
      detached_launch /usr/bin/proton-mail
      ;;
    calendar)
      if /usr/bin/flatpak info com.brave.Browser >/dev/null 2>&1; then
        detached_launch \
          /usr/bin/flatpak run com.brave.Browser \
          --app=https://calendar.proton.me/
      else
        detached_launch \
          /usr/bin/brave-browser-stable \
          --app=https://calendar.proton.me/
      fi
      ;;
    office)
      if [[ -x /usr/bin/desktopeditors ]]; then
        detached_launch /usr/bin/desktopeditors
      elif [[ -x /usr/bin/onlyoffice-desktopeditors ]]; then
        detached_launch /usr/bin/onlyoffice-desktopeditors
      elif [[ -x /opt/onlyoffice/desktopeditors/DesktopEditors ]]; then
        detached_launch /opt/onlyoffice/desktopeditors/DesktopEditors
      elif detached_launch /usr/bin/gtk-launch onlyoffice-desktopeditors; then
        :
      elif detached_launch /usr/bin/gtk-launch org.onlyoffice.desktopeditors; then
        :
      elif [[ -x /usr/bin/flatpak ]]; then
        detached_launch /usr/bin/flatpak run org.onlyoffice.desktopeditors
      else
        return 1
      fi
      ;;
  esac
}

case "$action" in
  open|focus)
    window_id="$(find_window)"

    if [[ -n "$window_id" ]]; then
      show_window "$window_id"
      exit 0
    fi

    launch_window || {
      echo "Could not launch $title" >&2
      exit 1
    }

    if window_id="$(wait_for_window)"; then
      show_window "$window_id"
      exit 0
    fi

    echo "Could not find the $title window" >&2
    exit 1
    ;;

  minimize)
    window_id="$(find_window)"

    if [[ -z "$window_id" ]]; then
      echo "$title is not open" >&2
      exit 1
    fi

    xdotool windowminimize "$window_id"
    ;;

  maximize)
    window_id="$(find_window)"

    if [[ -z "$window_id" ]]; then
      echo "$title is not open" >&2
      exit 1
    fi

    wmctrl -ir "$window_id" -b add,maximized_vert,maximized_horz
    ;;

  close)
    window_id="$(find_window)"

    if [[ -z "$window_id" ]]; then
      echo "$title is not open" >&2
      exit 1
    fi

    wmctrl -ic "$window_id"
    ;;

  *)
    echo \
      "Usage: jarvis-app-window {open|focus|minimize|maximize|close} APPLICATION" \
      >&2
    exit 2
    ;;
esac
