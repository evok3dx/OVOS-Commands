#!/usr/bin/env bash
set -euo pipefail

action="${1:-}"
agent_user="agent-claude"
workspace="/home/agent-claude/workspace"
claude="/home/agent-claude/.local/bin/claude"

if [[ "${EUID}" -ne 0 ]]; then
    echo "This helper must run through sudo." >&2
    exit 1
fi

[[ -d "$workspace" ]] || {
    echo "Claude workspace is unavailable." >&2
    exit 1
}
[[ -x "$claude" ]] || {
    echo "Claude executable is unavailable." >&2
    exit 1
}

case "$action" in
  new)
    session_count="$(
      /usr/sbin/runuser -u "$agent_user" -- \
        /usr/bin/tmux list-sessions -F '#S' 2>/dev/null |
      /usr/bin/grep -c '^voice-' || true
    )"
    if (( session_count >= 5 )); then
        echo "Five voice-created Claude sessions are already open." >&2
        exit 1
    fi

    session="voice-$(date +%Y%m%d-%H%M%S)-$$"
    exec /usr/sbin/runuser -u "$agent_user" -- \
      /usr/bin/tmux new-session \
      -s "$session" \
      -c "$workspace" \
      "$claude" --name "Voice $session"
    ;;
  agents)
    cd "$workspace"
    exec /usr/sbin/runuser -u "$agent_user" -- "$claude" agents
    ;;
  *)
    echo "Usage: $0 {new|agents}" >&2
    exit 2
    ;;
esac
