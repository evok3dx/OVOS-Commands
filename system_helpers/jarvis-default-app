#!/usr/bin/env python3
"""Control a fixed OS-default application without accepting a command line."""

from __future__ import annotations

import configparser
import re
import shutil
import subprocess
import sys
import time
from pathlib import Path


ROLE_MIME = {"mail": "x-scheme-handler/mailto"}
ACTIONS = {"open", "focus", "minimize", "maximize", "close"}


def desktop_id(role: str) -> str:
    result = subprocess.run(
        ["xdg-mime", "query", "default", ROLE_MIME[role]],
        check=True, capture_output=True, text=True, timeout=5,
    )
    value = result.stdout.strip()
    if not re.fullmatch(r"[A-Za-z0-9_.+-]+\.desktop", value):
        raise RuntimeError("No safe desktop association is configured")
    return value


def desktop_file(identifier: str) -> Path:
    roots = (
        Path.home() / ".local/share/applications",
        Path("/usr/local/share/applications"),
        Path("/usr/share/applications"),
    )
    for root in roots:
        candidate = root / identifier
        if candidate.is_file():
            return candidate
    raise RuntimeError(f"Desktop entry not found: {identifier}")


def window_needles(identifier: str, path: Path) -> set[str]:
    parser = configparser.ConfigParser(interpolation=None, strict=False)
    parser.optionxform = str
    parser.read(path, encoding="utf-8")
    section = parser["Desktop Entry"]
    values = {
        identifier.removesuffix(".desktop"),
        section.get("StartupWMClass", ""),
        section.get("Name", ""),
    }
    executable = section.get("Exec", "").strip().split(maxsplit=1)
    if executable:
        values.add(Path(executable[0]).name)
    return {value.lower() for value in values if len(value.strip()) >= 3}


def find_window(needles: set[str]) -> str | None:
    result = subprocess.run(
        ["wmctrl", "-lx"], check=False, capture_output=True, text=True, timeout=5,
    )
    for line in result.stdout.splitlines():
        lower = line.lower()
        if any(needle in lower for needle in needles):
            return line.split(maxsplit=1)[0]
    return None


def launch(identifier: str) -> None:
    gtk_launch = shutil.which("gtk-launch")
    if gtk_launch:
        subprocess.Popen(
            [gtk_launch, identifier.removesuffix(".desktop")],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
            start_new_session=True,
        )
    else:
        subprocess.Popen(
            ["xdg-open", "mailto:"], stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL, start_new_session=True,
        )


def main() -> int:
    if len(sys.argv) != 3 or sys.argv[1] not in ACTIONS or sys.argv[2] not in ROLE_MIME:
        print("Usage: jarvis-default-app ACTION mail", file=sys.stderr)
        return 2
    action, role = sys.argv[1:]
    identifier = desktop_id(role)
    needles = window_needles(identifier, desktop_file(identifier))
    window = find_window(needles)
    if action in {"open", "focus"} and not window:
        launch(identifier)
        for _ in range(80):
            time.sleep(0.1)
            window = find_window(needles)
            if window:
                break
    if not window:
        raise RuntimeError(f"Default {role} application is not open")
    if action in {"open", "focus"}:
        subprocess.run(["wmctrl", "-ia", window], check=True, timeout=5)
    elif action == "minimize":
        subprocess.run(["xdotool", "windowminimize", window], check=True, timeout=5)
    elif action == "maximize":
        subprocess.run(
            ["wmctrl", "-ir", window, "-b", "add,maximized_vert,maximized_horz"],
            check=True, timeout=5,
        )
    elif action == "close":
        subprocess.run(["wmctrl", "-ic", window], check=True, timeout=5)
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except (OSError, RuntimeError, subprocess.SubprocessError) as error:
        print(error, file=sys.stderr)
        raise SystemExit(1)
