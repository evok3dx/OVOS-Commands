#!/usr/bin/env bash
set -u

mode="${1:-}"
reading_speed="${2:-1}"
normal_speed_file="$HOME/.config/jarvis/reading-normal-speed"
speech_note_settings="$HOME/.var/app/net.mkiol.SpeechNote/config/net.mkiol/dsnote/settings.conf"
fast_marker="$HOME/.local/state/jarvis/reading-fast-active"
clipboard_backup="$(mktemp)"
captured_text="$(mktemp)"
captured_html="$(mktemp)"
main_text="$(mktemp)"
had_clipboard=0

restore_clipboard() {
    if [[ "$had_clipboard" -eq 1 ]]; then
        xclip -selection clipboard -i \
          < "$clipboard_backup" 2>/dev/null || true
    fi

    rm -f \
      "$clipboard_backup" \
      "$captured_text" \
      "$captured_html" \
      "$main_text"
}

trap restore_clipboard EXIT

if xclip -selection clipboard -o \
     > "$clipboard_backup" 2>/dev/null; then
    had_clipboard=1
fi

copy_browser_page() {
    local window_id
    local window_class

    window_id="$(xdotool getactivewindow 2>/dev/null)"
    window_class="$(xprop -id "$window_id" WM_CLASS 2>/dev/null)"
    window_class="${window_class,,}"

    case "$window_class" in
      *brave-browser*|*firefox*|*navigator*)
        ;;
      *)
        echo "The focused window is not a supported browser" >&2
        exit 1
        ;;
    esac

    # Clear the working clipboard so a failed Copy cannot replay stale text.
    : | xclip -selection clipboard -i

    xdotool key --clearmodifiers ctrl+a
    sleep 0.2
    xdotool key --clearmodifiers ctrl+c
    sleep 0.4
    xdotool key --clearmodifiers Escape 2>/dev/null || true

    if ! xclip -selection clipboard -o \
         > "$captured_text" 2>/dev/null; then
        echo "Could not copy the page" >&2
        exit 1
    fi

    if [[ ! -s "$captured_text" ]]; then
        echo "The copied page was empty" >&2
        exit 1
    fi
}

focused_window_class() {
    local window_id

    window_id="$(xdotool getactivewindow 2>/dev/null)" || return 1
    xprop -id "$window_id" WM_CLASS 2>/dev/null |
      tr '[:upper:]' '[:lower:]'
}

copy_accessible_content() {
    local window_id
    local window_pid

    window_id="$(xdotool getactivewindow 2>/dev/null)" || return 1
    window_pid="$(xprop -id "$window_id" _NET_WM_PID 2>/dev/null |
      awk -F' = ' 'NF == 2 { print $2; exit }')"

    [[ "$window_pid" =~ ^[0-9]+$ ]] || return 1

    /usr/bin/python3 - "$window_pid" "$captured_text" <<'PY'
import re
import sys
from pathlib import Path

import gi

gi.require_version("Atspi", "2.0")
from gi.repository import Atspi

wanted_pid = int(sys.argv[1])
target = Path(sys.argv[2])
desktop = Atspi.get_desktop(0)

included_roles = {
    "article", "document frame", "document text", "document web",
    "entry", "heading", "label", "list item", "paragraph",
    "section", "static", "table cell", "text",
}
excluded_roles = {
    "alert", "check box", "combo box", "dialog", "frame", "icon",
    "menu", "menu bar", "menu item", "page tab", "push button",
    "scroll bar", "separator", "status bar", "toggle button", "tool bar",
}

def children(node):
    try:
        return [node.get_child_at_index(index)
                for index in range(node.get_child_count())]
    except Exception:
        return []

def process_id(node):
    try:
        return node.get_process_id()
    except Exception:
        return -1

application = None
for candidate in children(desktop):
    if process_id(candidate) == wanted_pid:
        application = candidate
        break

def contains_focus(node, depth=0):
    if depth > 40:
        return False
    try:
        if node.get_state_set().contains(Atspi.StateType.FOCUSED):
            return True
    except Exception:
        pass
    return any(contains_focus(child, depth + 1) for child in children(node))

if application is None:
    for candidate in children(desktop):
        if contains_focus(candidate):
            application = candidate
            break

if application is None:
    raise SystemExit(1)

blocks = []
seen = set()

def add(value):
    value = re.sub(r"[ \t]+", " ", value or "")
    value = re.sub(r"\n{3,}", "\n\n", value).strip()
    if len(value) < 2 or value in seen:
        return
    seen.add(value)
    blocks.append(value)

def walk(node, depth=0):
    if depth > 80 or len(blocks) > 4000:
        return
    try:
        role = (node.get_role_name() or "").lower()
    except Exception:
        role = ""

    if role in excluded_roles:
        return

    if role in included_roles:
        try:
            text = node.get_text_iface()
            if text is not None:
                add(text.get_text(0, -1))
        except Exception:
            pass

        if role not in {"entry", "text"}:
            try:
                add(node.get_name() or "")
            except Exception:
                pass

    for child in children(node):
        walk(child, depth + 1)

walk(application)
result = "\n\n".join(blocks).strip()
if len(result) < 20:
    raise SystemExit(1)

target.write_text(result[:100000] + "\n", encoding="utf-8")
PY
}

copy_with_shortcut() {
    local select_keys="$1"
    local copy_keys="$2"

    # Clear the working clipboard so a failed Copy cannot replay stale text.
    : | xclip -selection clipboard -i

    xdotool key --clearmodifiers "$select_keys"
    sleep 0.2
    xdotool key --clearmodifiers "$copy_keys"
    sleep 0.4
    # Remove the temporary selection where the application supports Escape.
    xdotool key --clearmodifiers Escape 2>/dev/null || true

    if ! xclip -selection clipboard -o \
         > "$captured_text" 2>/dev/null; then
        echo "Could not copy readable content from the focused application" >&2
        return 1
    fi

    if [[ ! -s "$captured_text" ]]; then
        echo "The focused application did not provide readable content" >&2
        return 1
    fi
}

copy_focused_content() {
    local window_class

    window_class="$(focused_window_class)" || {
        echo "Could not identify the focused application" >&2
        return 1
    }

    case "$window_class" in
      *brave-browser*|*firefox*|*navigator*)
        copy_browser_page
        extract_main_content
        ;;
      *gnome-terminal*|*mate-terminal*|*xfce4-terminal*|*konsole*|*xterm*)
        # Terminal emulators reserve Ctrl+C for interrupting processes.
        copy_with_shortcut ctrl+shift+a ctrl+shift+c
        ;;
      *)
        # Read GTK, Qt and Electron content without moving focus or selecting
        # an app's composer. Fall back to copying only when accessibility is
        # unavailable or the application exposes too little useful text.
        copy_accessible_content || copy_with_shortcut ctrl+a ctrl+c
        ;;
    esac
}

extract_main_content() {
    # Browsers normally expose an HTML clipboard target after Copy. If they
    # do not, leave captured_text unchanged and use the safe full-page copy.
    if ! xclip -selection clipboard -t text/html -o \
         > "$captured_html" 2>/dev/null; then
        return 0
    fi

    if [[ ! -s "$captured_html" ]]; then
        return 0
    fi

    if ! "${OVOS_PYTHON:-$HOME/.venvs/ovos/bin/python}" \
         - "$captured_html" "$main_text" <<'PY'
import re
import sys
from pathlib import Path

from bs4 import BeautifulSoup


source = Path(sys.argv[1])
target = Path(sys.argv[2])
soup = BeautifulSoup(source.read_bytes(), "lxml")

for element in soup.select(
    "script, style, nav, header, footer, aside, form, button, "
    "svg, noscript, iframe, dialog"
):
    element.decompose()

candidates = []
for selector in ("main", "article", '[role="main"]'):
    candidates.extend(soup.select(selector))

def clean(value):
    value = re.sub(r"[ \t]+", " ", value)
    value = re.sub(r"\n{3,}", "\n\n", value)
    return value.strip()

def text_length(element):
    return len(clean(element.get_text(" ", strip=True)))

container = max(candidates, key=text_length) if candidates else soup.body
if container is None:
    raise SystemExit(0)

blocks = []
for element in container.select("h1, h2, h3, p, blockquote, pre, li"):
    value = clean(element.get_text(" ", strip=True))
    if len(value) < 2:
        continue
    if blocks and value == blocks[-1]:
        continue
    blocks.append(value)

result = clean("\n\n".join(blocks))
if len(result) < 120:
    result = clean(container.get_text("\n", strip=True))

# A short result is probably a browser-generated fragment without semantic
# article markup. In that case the shell helper retains the full-page copy.
if len(result) >= 120:
    target.write_text(result + "\n")
PY
    then
        return 0
    fi

    if [[ -s "$main_text" ]]; then
        cp "$main_text" "$captured_text"
    fi
}

case "$mode" in
  selection)
    if ! xclip -selection primary -o \
         > "$captured_text" 2>/dev/null; then
        echo "No selected text" >&2
        exit 1
    fi

    if [[ ! -s "$captured_text" ]]; then
        echo "No selected text" >&2
        exit 1
    fi
    ;;

  page)
    copy_focused_content
    ;;

  full-page)
    # Compatibility for older installed vocabulary. Reading is intentionally
    # limited to the focused application's useful content.
    copy_focused_content
    ;;

  *)
    echo \
      "Usage: jarvis-read-visible-text {selection|page|full-page}" \
      >&2
    exit 2
    ;;
esac

if [[ "$reading_speed" != "1" && "$reading_speed" != "2" ]]; then
    echo "Reading speed must be 1 or 2" >&2
    exit 2
fi

normal_speed="$(
    head -n 1 "$normal_speed_file" 2>/dev/null
)"
if [[ ! "$normal_speed" =~ ^([1-9]|1[0-9]|20)$ ]]; then
    normal_speed="$(sed -n 's/^speech_speed2=//p' "$speech_note_settings" 2>/dev/null | head -n 1)"
    [[ "$normal_speed" =~ ^([1-9]|1[0-9]|20)$ ]] || normal_speed=11
fi

set_speech_note_speed() {
    local value="$1"

    if grep -q '^speech_speed2=' "$speech_note_settings"; then
        sed -i \
          "s/^speech_speed2=.*/speech_speed2=$value/" \
          "$speech_note_settings"
    else
        sed -i \
          "/^\[General\]$/a speech_speed2=$value" \
          "$speech_note_settings"
    fi
}

mkdir -p "$(dirname "$fast_marker")"

if [[ "$reading_speed" == "2" ]]; then
    # On another PC, leave Speech Note alone if its settings cannot be
    # inspected and restored. Reading at normal speed still needs no edit.
    if [[ ! -f "$speech_note_settings" || -L "$speech_note_settings" || \
          ! -O "$speech_note_settings" || ! -w "$speech_note_settings" ]]; then
        echo "Cannot safely change Speech Note speed on this computer" >&2
        exit 1
    fi
    configured_speed="$(sed -n 's/^speech_speed2=//p' "$speech_note_settings" | head -n 1)"
    if [[ ! "$configured_speed" =~ ^([1-9]|1[0-9]|20)$ ]]; then
        echo "Speech Note speed setting needs review" >&2
        exit 1
    fi
    flatpak kill net.mkiol.SpeechNote >/dev/null 2>&1 || true
    sleep 1

    set_speech_note_speed 20
    : > "$fast_marker"
elif [[ -f "$fast_marker" ]]; then
    flatpak kill net.mkiol.SpeechNote >/dev/null 2>&1 || true
    sleep 1

    set_speech_note_speed "$normal_speed"
    rm -f -- "$fast_marker"
fi

xclip -selection clipboard -i < "$captured_text"

flatpak run net.mkiol.SpeechNote \
  --action start-reading-clipboard \
  >/dev/null 2>&1

result="$?"

if [[ "$reading_speed" == "2" ]]; then
    # The active task already received speed 20. Restore the saved setting
    # immediately so an unexpected shutdown cannot make 2x permanent.
    set_speech_note_speed "$normal_speed"
    if [[ "$result" -ne 0 ]]; then
        rm -f -- "$fast_marker"
        exit "$result"
    fi

    (
        saw_playback=0
        startup_checks=0

        while (( startup_checks < 150 || saw_playback == 1 )); do
            state="$(
                gdbus call \
                  --session \
                  --dest net.mkiol.SpeechNote \
                  --object-path /net/mkiol/SpeechNote \
                  --method org.freedesktop.DBus.Properties.Get \
                  net.mkiol.SpeechNote TaskState \
                  2>/dev/null |
                sed -n 's/.*<\([0-9][0-9]*\)>.*/\1/p'
            )"

            case "$state" in
                4|5|6)
                    saw_playback=1
                    ;;
                0)
                    if (( saw_playback == 1 )); then
                        break
                    fi
                    ;;
                '')
                    if (( saw_playback == 1 )); then
                        break
                    fi
                    ;;
            esac

            if (( saw_playback == 0 )); then
                startup_checks=$((startup_checks + 1))
            fi

            sleep 0.2
        done

        flatpak kill net.mkiol.SpeechNote >/dev/null 2>&1 || true
        set_speech_note_speed "$normal_speed"
        rm -f -- "$fast_marker"
    ) >/dev/null 2>&1 &
fi

sleep 1
exit "$result"
